[Unit]
Description=Verified encrypted PasKluis backup to private Google Drive folder
Wants=network-online.target
After=network-online.target paskluis-backup.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/flock -n /run/paskluis-offsite.lock /usr/bin/python3 /opt/paskluis-supabase/tools/offsite/drive_backup.py
TimeoutStartSec=50min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/backups/paskluis-supabase/daily
ReadWritePaths=/etc/paskluis-drive /var/lib/paskluis-offsite /run
Nice=10
